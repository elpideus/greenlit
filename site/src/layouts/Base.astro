---
import Btn from '../components/Btn.astro'
import Signal from '../components/Signal.astro'
import Wordmark from '../components/Wordmark.astro'
import { dicts, href, htmlLang, type Lang, langs, media } from '../i18n'
import '../styles/global.css'

interface Props {
  lang?: Lang
  /** this page's path below the language root ('' or 'start/'), for the language switch and hreflang */
  path?: string
  title?: string
  description?: string
  page?: 'home' | 'start' | '404'
  /** Extra schema.org nodes for this page (FAQPage, HowTo, BreadcrumbList…), added to the site's graph. */
  schema?: Record<string, unknown>[]
}
const { lang = 'en', path = '', page = 'home', schema = [] } = Astro.props
const t = dicts[lang]
const c = t.chrome
const { title = t.meta.title, description = t.meta.description } = Astro.props
const other: Lang = lang === 'it' ? 'en' : 'it'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const u = (p: string) => `${base}${p.replace(/^\//, '')}`
const abs = (p: string) => new URL(p, Astro.site).href
const site = abs(base)
const canonical = abs(Astro.url.pathname)
const og = abs(u('og.png'))
const repo = 'https://github.com/elpideus/greenlit'
const verification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim()
const home = href(lang)
const author = {
  '@type': 'Person',
  '@id': `${site}#author`,
  name: 'elpideus',
  url: 'https://elpideus.com',
  sameAs: ['https://github.com/elpideus', 'https://instagram.com/elpideus', 'https://youtube.com/@elpideus'],
}
const filmUrl = abs(media(lang, 'greenlit-film.mp4'))
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: 'Greenlit',
      description: dicts.en.meta.description,
      inLanguage: langs,
      publisher: { '@id': `${site}#author` },
    },
    author,
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}#software`,
      name: 'Greenlit',
      url: abs(home),
      description,
      inLanguage: lang,
      applicationCategory: 'MultimediaApplication',
      applicationSubCategory: t.schema.subCategory,
      operatingSystem: 'Linux, macOS, Windows (Docker)',
      softwareVersion: '0.1.0',
      isAccessibleForFree: true,
      license: 'https://www.gnu.org/licenses/gpl-3.0.html',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      downloadUrl: repo,
      codeRepository: repo,
      programmingLanguage: 'TypeScript',
      image: og,
      screenshot: [
        abs(media(lang, 'library-poster.webp')),
        abs(media(lang, 'review-poster.webp')),
        abs(media(lang, 'editor-poster.webp')),
      ],
      video: {
        '@type': 'VideoObject',
        name: t.schema.filmName,
        description: t.schema.filmDescription,
        inLanguage: lang,
        thumbnailUrl: abs(media(lang, 'film-poster.webp')),
        contentUrl: filmUrl,
        uploadDate: '2026-11-25',
        duration: 'PT50S',
      },
      featureList: t.schema.features,
      author: { '@id': `${site}#author` },
    },
    ...schema,
  ],
}
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {page !== '404' && langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(href(l, path))} />)}
    {page !== '404' && <link rel="alternate" hreflang="x-default" href={abs(href('en', path))} />}
    <script is:inline>
      // A visitor's language: the one they picked with the switch, else Italian for an Italian browser on its first
      // visit. Only pages that have both languages (the alternates above) move.
      ;(() => {
        try {
          const here = document.documentElement.lang
          let want = localStorage.getItem('gl.lang')
          if (!want && /^it\b/i.test(navigator.language || '')) want = 'it'
          if (!want || want === here) return
          const alt = document.querySelector(`link[rel="alternate"][hreflang="${want}"]`)
          // the same page on this host (the alternates carry the public address)
          if (alt) location.replace(new URL(alt.href).pathname + location.search + location.hash)
        } catch {}
      })()
      document.documentElement.classList.add('js')
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion')
    </script>
    <meta name="theme-color" content="#0c0d0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="sitemap" href={u('sitemap-index.xml')} />
    <link rel="manifest" href={u('site.webmanifest')} />
    <meta name="author" content="elpideus" />
    <meta name="robots" content={page === '404' ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <link rel="preload" href={u('fonts/geist.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Greenlit" />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={dicts[other].meta.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:video" content={filmUrl} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1920" />
    <meta property="og:video:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={t.meta.twitterAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">{c.skip}</a>
    <header class="top">
      <div class="wrap top__in">
        <a class="brand" href={home} aria-label={c.home}>
          <Signal state="greenlit" class="brand__signal" />
          <span>Greenlit</span>
        </a>
        {page === 'home' ? (
          <nav class="top__nav" id="site-nav" aria-label={c.sections}>
            {c.nav.map(([label, id]) => <a href={`#${id}`} data-nav={id}>{label}</a>)}
          </nav>
        ) : (
          <nav class="top__nav" aria-label={c.site}>
            <a href={home}>{c.overview}</a>
            <a href={href(lang, 'start/')} aria-current={page === 'start' ? 'true' : undefined}>{c.start}</a>
            <a href={`${repo}/tree/main/docs`} rel="noopener">{c.docs}</a>
          </nav>
        )}
        <div class="top__end">
          {page === 'home' && (
            <button class="top__menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
              <span class="top__menu-lines" aria-hidden="true"><i></i><i></i></span>
              <span>{c.menu}</span>
            </button>
          )}
          {page !== '404' && (
            <a class="langs" href={href(other, path)} hreflang={htmlLang[other]} lang={htmlLang[other]} aria-label={c.switchTo.label} data-lang-switch={other}>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M1.8 8h12.4M8 1.6c-2.2 2.4-2.2 10.4 0 12.8M8 1.6c2.2 2.4 2.2 10.4 0 12.8" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
              <span>{c.switchTo.code}</span>
            </a>
          )}
          <a class="gh" href={repo} rel="noopener" aria-label={c.github}>
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>GitHub</span>
          </a>
          <Btn href={href(lang, 'start/')} go>{c.start}</Btn>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <Wordmark class="foot__wm" />
        <div class="foot__row">
          <span>{c.foot} <a href="https://elpideus.com" rel="noopener">elpideus</a>.</span>
          <nav aria-label={c.footNav}>
            <a href={href(lang, 'start/')}>{c.start}</a>
            <a href={repo} rel="noopener">{c.source}</a>
            <a href={`${repo}/tree/main/docs`} rel="noopener">{c.docs}</a>
            <a href={`${repo}/blob/main/LICENSE`} rel="noopener">{c.licence}</a>
            <a href={`${home}#contact`}>{c.contact}</a>
          </nav>
        </div>
        {page !== '404' && (
          <nav class="foot__langs" aria-label={c.language}>
            {langs.map((l) => (
              <a href={href(l, path)} hreflang={htmlLang[l]} lang={htmlLang[l]} aria-current={l === lang ? 'true' : undefined} data-lang-switch={l}>
                {l === 'it' ? 'Italiano' : 'English'}
              </a>
            ))}
          </nav>
        )}
      </div>
    </footer>

    <dialog class="film" id="film" aria-label={c.film}>
      <button class="film__close" type="button" data-film-close aria-label={c.filmClose}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
      </button>
      <button class="film__sound" type="button" data-film-sound hidden>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 7v4h3l4 3.5V3.5L6 7H3z" fill="currentColor" /><path d="M12.5 6.2a4 4 0 0 1 0 5.6M14.6 4.1a7 7 0 0 1 0 9.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        {c.soundOn}
      </button>
      <video controls playsinline preload="none" poster={media(lang, 'film-poster.webp')} data-film-video>
        <source src={media(lang, 'greenlit-film.mp4')} type="video/mp4" />
      </video>
    </dialog>

    <script>
      import { boot } from '../scripts/main'
      boot()
    </script>
  </body>
</html>
