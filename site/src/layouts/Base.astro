---
import Btn from '../components/Btn.astro'
import Signal from '../components/Signal.astro'
import Wordmark from '../components/Wordmark.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  page?: 'home' | 'start' | '404'
  /** Extra schema.org nodes for this page (FAQPage, HowTo, BreadcrumbList…), added to the site's graph. */
  schema?: Record<string, unknown>[]
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const u = (p: string) => `${base}${p.replace(/^\//, '')}`
const {
  title = 'Greenlit · Self-hosted video review and social publishing for studios',
  description = 'Open-source, self-hosted video review and social publishing for studios: notes on the frame, a live editor and posts to Instagram, TikTok, YouTube and Facebook.',
  page = 'home',
  schema = [],
} = Astro.props
const site = new URL(base, Astro.site).href
const canonical = new URL(Astro.url.pathname, Astro.site).href
const og = new URL(u('og.png'), Astro.site).href
const repo = 'https://github.com/elpideus/greenlit'
const verification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim()
const nav = [
  ['Library', 'library'],
  ['Editor', 'editor'],
  ['Review', 'review'],
  ['Publishing', 'publishing'],
  ['Agents', 'agents'],
  ['Self-host', 'self-host'],
]
const author = {
  '@type': 'Person',
  '@id': `${site}#author`,
  name: 'elpideus',
  url: 'https://elpideus.com',
  sameAs: ['https://github.com/elpideus', 'https://instagram.com/elpideus', 'https://youtube.com/@elpideus'],
}
const shot = (f: string) => new URL(u(f), Astro.site).href
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: 'Greenlit',
      description,
      inLanguage: 'en',
      publisher: { '@id': `${site}#author` },
    },
    author,
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}#software`,
      name: 'Greenlit',
      url: site,
      description,
      applicationCategory: 'MultimediaApplication',
      applicationSubCategory: 'Video review and social media publishing',
      operatingSystem: 'Linux, macOS, Windows (Docker)',
      softwareVersion: '0.1.0',
      isAccessibleForFree: true,
      license: 'https://www.gnu.org/licenses/gpl-3.0.html',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      downloadUrl: repo,
      codeRepository: repo,
      programmingLanguage: 'TypeScript',
      image: og,
      screenshot: [
        shot('media/library-poster.webp'),
        shot('media/review-poster.webp'),
        shot('media/editor-poster.webp'),
      ],
      video: {
        '@type': 'VideoObject',
        name: 'Greenlit: the film',
        description:
          'Fifty seconds through Greenlit: the library, formats, the live editor, notes on the frame, approval and publishing to four platforms.',
        thumbnailUrl: shot('media/film-poster.webp'),
        contentUrl: shot('media/greenlit-film.mp4'),
        uploadDate: '2026-11-25',
        duration: 'PT50S',
      },
      featureList: [
        'Media library with formats, versions and audio tracks',
        'Video review with notes pinned on the frame and timecodes',
        'Single-use share links for client review on a phone',
        'Browser video editor that plays live without rendering',
        'Publishing and scheduling to Instagram, Facebook, TikTok and YouTube',
        'MCP server with 67 tools for Claude and other AI agents',
        'REST API with an OpenAPI document',
        'Brand kits, map and globe, production graph, version history',
      ],
      author: { '@id': `${site}#author` },
    },
    ...schema,
  ],
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0c0d0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="sitemap" href={u('sitemap-index.xml')} />
    <link rel="manifest" href={u('site.webmanifest')} />
    <meta name="author" content="elpideus" />
    <meta name="robots" content={page === '404' ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <link rel="preload" href={u('fonts/geist.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Greenlit" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Greenlit: the signal mark, flat blocks of green, amber and blue, and the wordmark." />
    <meta property="og:video" content={shot('media/greenlit-film.mp4')} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1920" />
    <meta property="og:video:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content="Greenlit: self-hosted video review and social publishing." />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      document.documentElement.classList.add('js')
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion')
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top__in">
        <a class="brand" href={u('')} aria-label="Greenlit, home">
          <Signal state="greenlit" class="brand__signal" />
          <span>Greenlit</span>
        </a>
        {page === 'home' ? (
          <nav class="top__nav" id="site-nav" aria-label="Sections">
            {nav.map(([label, id]) => <a href={`#${id}`} data-nav={id}>{label}</a>)}
          </nav>
        ) : (
          <nav class="top__nav" aria-label="Site">
            <a href={u('')}>Overview</a>
            <a href={u('start/')} aria-current={page === 'start' ? 'true' : undefined}>Get started</a>
            <a href={`${repo}/tree/main/docs`} rel="noopener">Docs</a>
          </nav>
        )}
        <div class="top__end">
          {page === 'home' && (
            <button class="top__menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
              <span class="top__menu-lines" aria-hidden="true"><i></i><i></i></span>
              <span>Menu</span>
            </button>
          )}
          <a class="gh" href={repo} rel="noopener" aria-label="Greenlit on GitHub">
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>GitHub</span>
          </a>
          <Btn href={u('start/')} go>Get started</Btn>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <Wordmark class="foot__wm" />
        <div class="foot__row">
          <span>Greenlit is free software under the GPL-3.0-or-later. Made by <a href="https://elpideus.com" rel="noopener">elpideus</a>.</span>
          <nav aria-label="Footer">
            <a href={u('start/')}>Get started</a>
            <a href={repo} rel="noopener">Source</a>
            <a href={`${repo}/tree/main/docs`} rel="noopener">Docs</a>
            <a href={`${repo}/blob/main/LICENSE`} rel="noopener">Licence</a>
            <a href={`${base}#contact`}>Contact</a>
          </nav>
        </div>
      </div>
    </footer>

    <dialog class="film" id="film" aria-label="The Greenlit film">
      <button class="film__close" type="button" data-film-close aria-label="Close the film">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
      </button>
      <video controls playsinline preload="none" poster={u('media/film-poster.webp')} data-film-video>
        <source src={u('media/greenlit-film.mp4')} type="video/mp4" />
      </video>
    </dialog>

    <script>
      import { boot } from '../scripts/main'
      boot()
    </script>
  </body>
</html>
