---
import Btn from '../components/Btn.astro'
import Signal from '../components/Signal.astro'
import { dicts, href } from '../i18n'
import Base from '../layouts/Base.astro'

// GitHub Pages serves this one page for every missing address, so it carries both languages and shows the Italian
// one under /it/.
const { en, it } = dicts
---
<Base title={en.lost.title} description={en.lost.description} page="404">
  <section class="lost">
    <div class="wrap" data-lost="en">
      <Signal state="changes" label={en.lost.signal} />
      <h1 class="h2">{en.lost.h1}</h1>
      <p class="lede">{en.lost.lede}</p>
      <Btn href={href('en')} go arrow>{en.lost.back}</Btn>
    </div>
    <div class="wrap" data-lost="it" lang="it" hidden>
      <Signal state="changes" label={it.lost.signal} />
      <h1 class="h2">{it.lost.h1}</h1>
      <p class="lede">{it.lost.lede}</p>
      <Btn href={href('it')} go arrow>{it.lost.back}</Btn>
    </div>
  </section>
  <script is:inline>
    if (/\/it(\/|$)/.test(location.pathname)) {
      document.querySelector('[data-lost="en"]').hidden = true
      document.querySelector('[data-lost="it"]').hidden = false
      document.documentElement.lang = 'it'
      document.title = 'Niente su questo fotogramma · Greenlit'
    }
  </script>
</Base>
