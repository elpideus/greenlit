---
import { Image } from 'astro:assets'
import api from '../assets/shots/api.webp'
import brandLight from '../assets/shots/brand-light.webp'
import calendar from '../assets/shots/calendar.webp'
import globe from '../assets/shots/globe.webp'
import graph from '../assets/shots/graph.webp'
import history from '../assets/shots/history.webp'
import mReview from '../assets/shots/m-review.webp'
import Btn from '../components/Btn.astro'
import Signal from '../components/Signal.astro'
import Wordmark from '../components/Wordmark.astro'
import { contactEmail, links } from '../data/contact'
import { faq } from '../data/faq'
import Base from '../layouts/Base.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const m = (p: string) => `${base}media/${p}`
const repo = 'https://github.com/elpideus/greenlit'

const statement =
  'Footage sits in one app. Notes arrive in a chat. Edits live somewhere else, and posts go out through four more. Greenlit puts the work, the decisions and the publishing in one quiet room, on your own server.'
const words = statement.split(' ')
const green = new Set(['Greenlit'])

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
]

const phones = [
  { id: 'ig', name: 'Instagram Reel', when: 'Dec 2 · 18:30' },
  { id: 'fb', name: 'Facebook Reel', when: 'Dec 2 · 18:30' },
  { id: 'tt', name: 'TikTok', when: 'Dec 2 · 19:00' },
  { id: 'yt', name: 'YouTube', when: 'Dec 2 · 17:00' },
]
---
<Base schema={schema}>
  <!-- ── hero ──────────────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-title" data-chapter="draft">
    <div class="wrap hero__grid">
      <div class="hero__lead">
        <h1 id="hero-title" class="hero__title">
          <span class="sr-only">Greenlit: footage, review and publishing for studios</span>
          <Wordmark class="hero__wm" dot="hero__dot" />
        </h1>
        <div class="hero__copy">
          <p class="lede" data-reveal style="--d: .35s">
            Footage, review and publishing for studios that film their work. Self-hosted, open source, and built so
            people and AI agents work side by side.
          </p>
          <div class="hero__actions" data-reveal style="--d: .5s">
            <Btn href={`${base}start/`} go arrow>Get started</Btn>
            <Btn href="#film" button id="play-film" play>Watch the film · 0:50</Btn>
          </div>
          <ul class="hero__facts" data-reveal style="--d: .62s">
            <li>Free and open source</li>
            <li>Runs on your own server</li>
            <li>67 tools for Claude over MCP</li>
          </ul>
        </div>
      </div>
      <div class="comp" aria-hidden="true">
        <div class="comp__col" data-comp="col">
          <Signal state="draft" class="comp__sig" />
          <Signal state="draft" class="comp__sig" />
        </div>
        <div class="comp__panel" data-comp="panel"><Signal state="draft" class="comp__sig" /></div>
        <div class="comp__tile" data-comp="tile"></div>
        <div class="comp__sq" data-comp="sq"></div>
      </div>
    </div>
  </section>

  <section class="stage" aria-label="Greenlit’s library, recorded in the app">
    <div class="wrap">
      <div class="window" data-stage>
        <video autoplay muted loop playsinline preload="metadata" poster={m('library-poster.webp')} data-autoplay>
          <source src={m('library.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="stage__caption">
        <span>The library: projects, formats and hover-scrub previews. Recorded in Greenlit, nothing mocked up.</span>
      </div>
    </div>
  </section>

  <!-- ── statement ─────────────────────────────────────────────────────── -->
  <section class="statement" aria-label="Why Greenlit">
    <div class="wrap">
      <p data-statement>
        {words.map((w) => <span class:list={['w', { g: green.has(w.replace(/[.,]/g, '')) }]}>{w} </span>)}
      </p>
    </div>
  </section>

  <!-- ── library ───────────────────────────────────────────────────────── -->
  <section class="chapter" id="library" data-chapter="draft" aria-labelledby="library-title">
    <div class="wrap">
      <div class="chapter__head">
        <div>
          <p class="state" data-reveal><Signal state="draft" />Footage in</p>
          <h2 id="library-title" class="h2 split-words" data-words>One shot. Every format.</h2>
        </div>
        <p class="lede" data-reveal style="--d: .15s">
          A media item holds every shape of the same content: the 16:9 film, the 9:16 reel, the 1:1 post. Versions
          combine, like English or Italian with or without the watermark, and extra audio tracks ride along for a
          voice-over in another language.
        </p>
      </div>
      <div class="formats">
        {[
          ['16 / 9', '16:9', 'Main'],
          ['9 / 16', '9:16', 'Vertical'],
          ['1 / 1', '1:1', 'Square'],
        ].map(([ar, k, n], i) => (
          <figure data-reveal style={`--d: ${i * 0.12}s`}>
            <div class="frame" style={`aspect-ratio: ${ar}`}>
              <video autoplay muted loop playsinline preload="none" poster={m('coast-poster.webp')} data-autoplay aria-hidden="true">
                <source src={m('coast.mp4')} type="video/mp4" />
              </video>
            </div>
            <figcaption><b>{k}</b><span>{n}</span></figcaption>
          </figure>
        ))}
      </div>
      <ul class="points">
        <li data-reveal><b>Formats travel together</b>Each post picks the shape its platform wants, so nothing gets cropped by accident.</li>
        <li data-reveal style="--d:.08s"><b>Search that understands you</b>Type <span class="tok">status:approved</span>, <span class="tok">#drone</span> or <span class="tok">project:</span> and pick from suggestions.</li>
        <li data-reveal style="--d:.16s"><b>Made for you on upload</b>Thumbnails, hover-scrub previews, waveforms, EXIF dates and places.</li>
        <li data-reveal style="--d:.24s"><b>Right-click everything</b>Drop files anywhere to upload, rename in place, act on a selection.</li>
      </ul>
    </div>
  </section>

  <!-- ── editor ────────────────────────────────────────────────────────── -->
  <section class="chapter" id="editor" data-chapter="draft" aria-labelledby="editor-title">
    <div class="wrap">
      <div class="chapter__head chapter__head--center">
        <p class="state" data-reveal><Signal state="draft" />In the edit</p>
        <h2 id="editor-title" class="h2 split-words" data-words>Edits play live. Nothing to render.</h2>
        <p class="lede" data-reveal style="--d: .15s">
          A timeline where compositions play in the browser as you build them: video, pictures, audio, text, shapes
          and code layers that run any HTML, CSS or JavaScript animation, frame by frame.
        </p>
      </div>
      <div class="editor-grid" data-reveal>
        <div class="window" style="aspect-ratio: 16 / 10">
          <video autoplay muted loop playsinline preload="none" poster={m('editor-poster.webp')} data-autoplay aria-label="The editor plays a 15-second teaser, then switches between its 16:9, 9:16 and 1:1 formats.">
            <source src={m('editor.mp4')} type="video/mp4" />
          </video>
        </div>
        <div class="term" data-term aria-label="Claude Code using Greenlit’s MCP tools">
          <div class="term__bar"><i></i><i></i><i></i><span>claude · greenlit</span></div>
          <div class="term__body">
            <div class="term__line" data-line="prompt"><span class="m">&gt;</span><span>Make a vertical cut of the Coastline teaser.</span></div>
            <div class="term__line tool" data-line><span class="m">●</span><span>editor_get  Coastline · 15 s teaser</span></div>
            <div class="term__line tool" data-line><span class="m">●</span><span>editor_apply  4 ops · reframe for 9:16</span></div>
            <div class="term__line tool" data-line><span class="m">●</span><span>editor_frames  0:02  0:07  0:12</span></div>
            <div class="term__line ok" data-line><span class="m">✓</span><span>Done. The 9:16 format is ready to check.</span></div>
          </div>
        </div>
      </div>
      <ul class="points" style="margin-top: clamp(96px, 10vw, 140px)">
        <li data-reveal><b>Claude edits with you</b>The same document through MCP. Every open editor updates instantly.</li>
        <li data-reveal style="--d:.08s"><b>Keyframes and transitions</b>On any property: position, scale, opacity, blur, colour, text size.</li>
        <li data-reveal style="--d:.16s"><b>One edit, every format</b>Reframe per format, or let it follow the subject from 16:9 to 9:16.</li>
        <li data-reveal style="--d:.24s"><b>Frame-exact exports</b>They land in the library as formats of one item, linked to their sources.</li>
      </ul>
    </div>
  </section>

  <!-- ── review ────────────────────────────────────────────────────────── -->
  <section class="chapter" id="review" data-chapter="review" aria-labelledby="review-title">
    <div class="wrap">
      <div class="chapter__head">
        <div>
          <p class="state" data-reveal><Signal state="review" />In review</p>
          <h2 id="review-title" class="h2 split-words" data-words>Notes land on the frame.</h2>
        </div>
        <p class="lede" data-reveal style="--d: .15s">
          Reviewers click the picture at the exact moment to leave a note, or drag to mark an area. They attach media,
          files or pasted pictures, and ask for changes as a checklist that can’t be sent empty.
        </p>
      </div>
      <div class="review-stage" data-reveal>
        <div class="sframe" data-state="review" data-review-frame>
          <div class="window">
            <video muted playsinline preload="none" poster={m('review-poster.webp')} data-review-video aria-label="Giulia sees her earlier notes done, pins a last note on the frame and accepts the cut.">
              <source src={m('review.mp4')} type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="sframe__bar">
          <p class="status" aria-live="polite">
            <Signal state="review" class="status__signal" />
            <span class="status__text">
              <span data-status="review">Waiting for Giulia</span>
              <span data-status="greenlit" aria-hidden="true">Greenlit by Giulia</span>
            </span>
          </p>
          <span class="mono muted">Coastline · Hero film · 0:12</span>
        </div>
      </div>
      <ul class="points">
        <li data-reveal><b>Timecoded, on the spot</b>Every note keeps its moment and its place, and shows on the scrubber.</li>
        <li data-reveal style="--d:.08s"><b>Changes as a checklist</b>Admins tick notes off, send work back for review, or approve it themselves.</li>
        <li data-reveal style="--d:.16s"><b>Review from a phone</b>A single-use link signs your client in to one item, with an expiry.</li>
        <li data-reveal style="--d:.24s"><b>Nothing gets lost</b>Titles, notes, files, posts and edits keep a history you can compare and restore.</li>
      </ul>
    </div>
  </section>

  <!-- ── the greenlit moment ───────────────────────────────────────────── -->
  <section class="moment" data-moment data-chapter="greenlit" aria-labelledby="moment-title">
    <div class="moment__pin">
      <h2 id="moment-title" class="moment__word">
        <span class="sr-only">Greenlit</span>
        <Wordmark class="moment__wm" dot="moment__dot" />
      </h2>
      <p class="moment__line">One click from the reviewer, and the cut moves on to publishing. Everyone sees it, nobody chases it.</p>
      <a class="moment__cue" href="#publishing"><span class="moment__cue-label">Keep scrolling</span><span class="moment__cue-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18"><path d="M9 3v11M4 9.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
      <div class="moment__field" data-moment-field aria-hidden="true">
        <div class="moment__word"><Wordmark class="moment__wm" /></div>
        <p class="moment__line" data-copy-of="One click from the reviewer, and the cut moves on to publishing. Everyone sees it, nobody chases it."></p>
        <span class="moment__cue"><span class="moment__cue-label" data-copy-of="Keep scrolling"></span><span class="moment__cue-arrow"><svg width="18" height="18" viewBox="0 0 18 18"><path d="M9 3v11M4 9.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span></span>
      </div>
    </div>
  </section>

  <!-- ── publishing ────────────────────────────────────────────────────── -->
  <section class="chapter" id="publishing" data-chapter="scheduled" aria-labelledby="publishing-title">
    <div class="wrap">
      <div class="chapter__head chapter__head--center">
        <p class="state" data-reveal><Signal state="scheduled" />Scheduled</p>
        <h2 id="publishing-title" class="h2 split-words" data-words>Scheduled where your audience is.</h2>
        <p class="lede" data-reveal style="--d: .15s">
          One post, four platforms, each with its own caption, title, cover, music and options. Schedules are held on
          the platforms themselves. Sign in with the accounts you already use: no developer apps.
        </p>
      </div>
      <div class="phones">
        {phones.map((p, i) => (
          <figure class="phone" data-reveal style={`--d: ${[0, 0.14, 0.24, 0.3][i]}s`}>
            <div class="phone__screen">
              <video autoplay muted loop playsinline preload="none" poster={m(`phone-${p.id}-poster.webp`)} data-autoplay aria-hidden="true">
                <source src={m(`phone-${p.id}.mp4`)} type="video/mp4" />
              </video>
            </div>
            <figcaption>{p.name}<span>{p.when}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="window cal" data-reveal>
        <Image src={calendar} widths={[800, 1400, 2000, 2400]} sizes="(min-width: 1400px) 1360px, 100vw" alt="The posts calendar for November 2026: scheduled and published posts with their platform icons." loading="lazy" />
      </div>
      <ul class="points">
        <li data-reveal><b>Previews that look like the apps</b>See the reel, the feed post and the short the way each app will show them.</li>
        <li data-reveal style="--d:.08s"><b>Music from the platform</b>Pick tracks from each platform’s own library. They stay linked there.</li>
        <li data-reveal style="--d:.16s"><b>Encoded per placement</b>Every file is re-encoded with the settings that placement prefers.</li>
        <li data-reveal style="--d:.24s"><b>Edits flow both ways</b>Change a scheduled post in Greenlit or on the platform; both stay in sync.</li>
      </ul>
    </div>
  </section>

  <!-- ── everything else ───────────────────────────────────────────────── -->
  <section class="chapter light" id="more" aria-labelledby="more-title">
    <div class="wrap">
      <div class="chapter__head">
        <h2 id="more-title" class="h2 split-words" data-words>And everything around the work.</h2>
        <p class="lede" data-reveal style="--d: .15s">
          The parts a studio reaches for every week, built in rather than bolted on.
        </p>
      </div>
      <div class="bento">
        <article class="card card--wide card--dark" data-reveal>
          <div class="card__text"><h3 class="h3">Map and globe</h3><p>Projects and media where they were shot, read from GPS tags or placed by hand. Search understands <span class="tok">place:</span>.</p></div>
          <div class="card__media"><Image src={globe} widths={[700, 1200, 1700]} sizes="(min-width: 960px) 66vw, 100vw" alt="Greenlit’s globe view with photo pins on Europe, Africa and Asia." loading="lazy" /></div>
        </article>
        <article class="card card--dark card--phone" data-reveal style="--d:.1s">
          <div class="card__text"><h3 class="h3">Review from a phone</h3><p>Your client opens one link and decides on the go.</p></div>
          <div class="card__media"><Image src={mReview} widths={[400, 700]} sizes="(min-width: 960px) 22vw, 60vw" alt="The review queue on a phone, five items waiting." loading="lazy" /></div>
        </article>
        <article class="card card--half card--dark card--center" data-reveal>
          <div class="card__text"><h3 class="h3">The production graph</h3><p>Every photo, still, clip and film, laid out by process: what was shot, what was made from it, where it was posted.</p></div>
          <div class="card__media"><Image src={graph} widths={[600, 1000, 1400]} sizes="(min-width: 960px) 50vw, 100vw" alt="The production graph by process: drone shots and stills flow into the hero film, its 15-second teaser and the post." loading="lazy" /></div>
        </article>
        <article class="card card--half" data-reveal style="--d:.1s">
          <div class="card__text"><h3 class="h3">Brand kits</h3><p>Drop a kit’s folder. Greenlit reads its colours, fonts and logos, and shows it as a brand book.</p></div>
          <div class="card__media"><Image src={brandLight} widths={[600, 1000, 1400]} sizes="(min-width: 960px) 50vw, 100vw" alt="A brand kit for a ceramics studio: its mark on clay, five colours and its type." loading="lazy" /></div>
        </article>
        <article class="card card--dark card--right" data-reveal>
          <div class="card__text"><h3 class="h3">History you can restore</h3><p>Who changed what, through the app or the API, and the way back.</p></div>
          <div class="card__media"><Image src={history} widths={[500, 900, 1300]} sizes="(min-width: 960px) 33vw, 100vw" alt="The history panel of a video: status and format changes by Giulia and Alex." loading="lazy" /></div>
        </article>
        <article class="card card--list card--wide" data-reveal style="--d:.1s">
          <div class="card__text"><h3 class="h3">Also inside</h3></div>
          <ul>
            <li>Share links that sign one person in to one post, item or project, and expire</li>
            <li>Storage that archives old media by itself, one file at a time</li>
            <li>Code, Markdown, HTML and PDF in the viewer, and FigCraft designs, live</li>
            <li>Depth maps for pictures and video, made by Greenlit or brought along</li>
            <li>Theme packs, your own logos, English and Italian</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ── agents ────────────────────────────────────────────────────────── -->
  <section class="chapter" id="agents" aria-labelledby="agents-title">
    <div class="wrap split">
      <div>
        <h2 id="agents-title" class="h2 split-words" data-words>Built for people and AI agents.</h2>
        <p class="lede" style="margin-top: 28px" data-reveal>
          Every part of Greenlit is a documented REST API and an MCP server. Claude Code can search the library, cut a
          video in the editor while you watch, leave notes and prepare posts, with your permissions.
        </p>
        <div class="stats">
          <div data-reveal><b data-count="67">67</b><span>MCP tools</span></div>
          <div data-reveal style="--d:.08s"><b>REST</b><span>with an OpenAPI document</span></div>
          <div data-reveal style="--d:.16s"><b>Live</b><span>editor API for browser agents</span></div>
        </div>
      </div>
      <div data-reveal style="--d:.1s">
        <div class="code">
          <div class="code__bar"><span>Connect Claude Code</span><button class="copy" type="button" data-copy="claude mcp add --transport http greenlit https://your-greenlit/api/mcp --header &quot;Authorization: Bearer glt_…&quot;">Copy</button></div>
          <pre><code><span class="c"># a token from Settings → API &amp; MCP</span>
claude mcp add --transport http greenlit \
  https://your-greenlit/api/mcp \
  --header <span class="s">"Authorization: Bearer glt_…"</span></code></pre>
        </div>
        <ul class="asks">
          <li>Make a 15-second vertical teaser from the drone shots in Coastline.</li>
          <li>Which cuts are still waiting for Giulia? Summarise her notes.</li>
          <li>Draft Friday’s posts for Instagram and TikTok from the approved reels.</li>
        </ul>
        <div class="window" style="margin-top: 24px">
          <Image src={api} widths={[700, 1200, 1800]} sizes="(min-width: 900px) 55vw, 100vw" alt="Greenlit’s API and MCP settings page with the Claude Code setup steps." loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── self-host ─────────────────────────────────────────────────────── -->
  <section class="chapter" id="self-host" aria-labelledby="self-title">
    <div class="wrap split">
      <div>
        <h2 id="self-title" class="h2 split-words" data-words>Your server. Your footage.</h2>
        <p class="lede" style="margin-top: 28px" data-reveal>
          One Docker Compose project runs the app, its database, an Android device for what only a platform’s app can
          do, and an optional Cloudflare Tunnel. Nothing listens on a public port.
        </p>
        <ul class="points" style="grid-template-columns: 1fr 1fr">
          <li data-reveal><b>GPL-3.0-or-later</b>Free software, yours to run, read and change.</li>
          <li data-reveal style="--d:.08s"><b>Built in modules</b>Add, change or remove a part without touching the rest.</li>
        </ul>
      </div>
      <div data-reveal style="--d:.1s">
        <div class="code">
          <div class="code__bar"><span>Quick start</span><button class="copy" type="button" data-copy="git clone https://github.com/elpideus/greenlit && cd greenlit && cp .env.example .env && docker compose up -d --build">Copy</button></div>
          <pre><code>git clone https://github.com/elpideus/greenlit
cd greenlit
cp .env.example .env   <span class="c"># set GREENLIT_SECRET and the public URL</span>
docker compose up -d --build
docker compose logs app | grep <span class="s">"setup code"</span></code></pre>
        </div>
        <p class="body" style="margin-top: 18px">
          Then open Greenlit, create the first admin with the setup code and invite people in Settings → People.
          The <a class="link" href={`${base}start/`}>getting started guide</a> has the details.
        </p>
      </div>
    </div>
  </section>

  <!-- ── questions ─────────────────────────────────────────────────────── -->
  <section class="chapter" id="faq" aria-labelledby="faq-title">
    <div class="wrap split">
      <div>
        <h2 id="faq-title" class="h2 split-words" data-words>Questions, answered.</h2>
        <p class="lede" style="margin-top: 28px" data-reveal>
          The short version: free, self-hosted, four platforms, and built to work with Claude.
        </p>
      </div>
      <div class="faq" data-reveal style="--d:.1s">
        {faq.map(({ q, a }, i) => (
          <details open={i === 0}>
            <summary><h3>{q}</h3><span class="faq__mark" aria-hidden="true"></span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── contact ───────────────────────────────────────────────────────── -->
  <section class="chapter contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <Signal state="greenlit" class="contact__signal" />
      <h2 id="contact-title" class="h2 split-words" data-words>Want it running for your studio?</h2>
      <p class="lede" data-reveal>
        Greenlit is free and open source. If you’d like a hand setting it up, a feature built for your team, or just to
        say hello, write to me.
      </p>
      <div class="contact__links" data-reveal style="--d:.1s">
        {contactEmail && <Btn href={`mailto:${contactEmail}`} go lamp>{contactEmail}</Btn>}
        <Btn href={links.website} go={!contactEmail} external arrow>elpideus.com</Btn>
        <Btn href={links.instagram} external arrow>Instagram</Btn>
        <Btn href={links.github} external arrow>GitHub</Btn>
        <Btn href={links.youtube} external arrow>YouTube</Btn>
      </div>
    </div>
  </section>
</Base>
