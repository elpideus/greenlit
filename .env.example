# Copy to .env and fill in. Never commit .env.

# Required in production: 32+ random characters (openssl rand -hex 32).
GREENLIT_SECRET=

# The address people use to open Greenlit (share links and the MCP setup text use it), e.g. your Cloudflare
# hostname: https://greenlit.example.com (a bare host name gets https:// added).
GREENLIT_PUBLIC_URL=https://greenlit.example.com

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=greenlit

# Background workers running at once (processing, renders, publishing).
GREENLIT_WORKERS=2

# Default time zone of the machine (the platform time zone is set in Settings → General).
TZ=Europe/Rome

# Greenlit's Android device (YouTube Shorts sounds): on by default, needs /dev/kvm. Remove `android` to leave it
# out.
COMPOSE_PROFILES=android
ANDROID_RAM_MB=4096
ANDROID_CORES=4
# The Android SDK License hash you accepted on this machine, to build the device:
#   sdkmanager --licenses, then the hash in ~/Android/Sdk/licenses/android-sdk-license
# ANDROID_SDK_LICENSE=

# Cloudflare Tunnel: the only way to reach Greenlit (no port is published on this computer). With a token the tunnel
# starts with everything else; point its public hostname at http://app:8080 in Cloudflare
# (Zero Trust → Networks → Tunnels → the tunnel → Public hostnames).
CLOUDFLARE_TUNNEL_TOKEN=

# Development: `pnpm dev` reads .env.development (git-ignored), never this production .env, so dev keeps its own
# secret (data/.dev-secret), address and data. Put any of these there:
# GREENLIT_DATABASE_URL=postgres://greenlit:greenlit@localhost:54329/greenlit
# GREENLIT_DATA_DIR=./data
# GREENLIT_DISABLED_MODULES=
# GREENLIT_ANDROID_ADB=127.0.0.1:15037
# FigCraft for design files (the Docker image sets both): the unpacked browser build, and figcraft-cli for thumbnails.
# GREENLIT_FIGCRAFT_WEB_DIR=./data/vendor/figcraft-web-0.18.1
# GREENLIT_FIGCRAFT_CLI=/usr/local/bin/figcraft-cli
