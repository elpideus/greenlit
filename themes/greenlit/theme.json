{
  "id": "greenlit",
  "name": "Greenlit",
  "builtIn": true,
  "defaultMode": "system",
  "radius": 12,
  "fonts": {
    "ui": { "family": "Geist Variable", "fallback": "Geist, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif" },
    "display": { "family": "Geist Variable", "fallback": "Geist, -apple-system, system-ui, sans-serif" },
    "mono": { "family": "Geist Mono Variable", "fallback": "'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace" }
  },
  "display": { "uppercase": false, "letterSpacing": -0.024, "weight": 600 },
  "light": {
    "bg": "#F5F7F6",
    "bgSubtle": "#EAEDEB",
    "surface": "#FFFFFF",
    "surfaceRaised": "#FFFFFF",
    "surfaceHover": "#EEF1EF",
    "border": "rgba(20,23,21,0.09)",
    "borderStrong": "rgba(20,23,21,0.17)",
    "text": "#141715",
    "textMuted": "#525753",
    "textSubtle": "#686D69",
    "accent": "#007F3D",
    "accentHover": "#006E35",
    "accentText": "#FFFFFF",
    "accentSoft": "rgba(0,127,61,0.10)",
    "success": "#007F3D",
    "warning": "#A35F00",
    "danger": "#C52C2A",
    "info": "#1C65C8",
    "focus": "#007F3D",
    "overlay": "rgba(20,23,21,0.32)"
  },
  "dark": {
    "bg": "#0C0D0C",
    "bgSubtle": "#090A09",
    "surface": "#131413",
    "surfaceRaised": "#1A1C1A",
    "surfaceHover": "#212322",
    "border": "rgba(237,239,237,0.08)",
    "borderStrong": "rgba(237,239,237,0.15)",
    "text": "#EDEFED",
    "textMuted": "#A8ACA9",
    "textSubtle": "#828683",
    "accent": "#42D77B",
    "accentHover": "#5BDF8E",
    "accentText": "#04210F",
    "accentSoft": "rgba(66,215,123,0.14)",
    "success": "#42D77B",
    "warning": "#F9B73F",
    "danger": "#F75D59",
    "info": "#6AA7F4",
    "focus": "#42D77B",
    "overlay": "rgba(4,5,4,0.62)"
  }
}
