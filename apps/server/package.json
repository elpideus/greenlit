{
  "name": "@greenlit/server",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=drizzle --watch-path=../../packages --env-file-if-exists=../../.env.development src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli.ts migrate",
    "cli": "node --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@greenlit/composition": "workspace:*",
    "@greenlit/platforms": "workspace:*",
    "@greenlit/shared": "workspace:*",
    "@hono/mcp": "0.3.5",
    "@hono/node-server": "2.1.11",
    "@hono/node-ws": "1.3.2",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@scalar/hono-api-reference": "0.12.23",
    "@tus/file-store": "2.1.2",
    "@tus/server": "2.4.7",
    "api-anything": "workspace:*",
    "drizzle-orm": "0.45.4",
    "exifr": "^7.1.3",
    "hono": "4.13.19",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "playwright-core": "1.65.1",
    "postgres": "4.1.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.1.0"
  }
}
